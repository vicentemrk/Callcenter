# Copia este archivo como ".env" y completa los valores.
# El archivo ".env" esta en .gitignore: no se sube al repositorio.

# ---------------------------------------------------------------
# Django
# ---------------------------------------------------------------
DJANGO_DEBUG=True
# Obligatoria cuando DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo se usan si DJANGO_DEBUG=False (produccion con MySQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# ---------------------------------------------------------------
# Asistente IA (costo 0)
# ---------------------------------------------------------------
# auto  -> usa Groq si IA_API_KEY tiene valor; si no, motor local
# local -> siempre motor local (reglas + base de conocimiento, sin internet)
# groq  -> siempre Groq
IA_PROVEEDOR=auto

# Clave gratuita de https://console.groq.com  (NO la subas al repositorio)
IA_API_KEY=

# Compatible con OpenAI: sirve para Groq, OpenRouter, Ollama u OpenAI
IA_BASE_URL=https://api.groq.com/openai/v1
IA_MODEL=openai/gpt-oss-20b
IA_TIMEOUT=15
IA_MAX_TOKENS=400

# Limites de uso por usuario
IA_LIMITE_POR_HORA=15
IA_CACHE_SEGUNDOS=600
