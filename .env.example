# Copia este archivo como ".env" y completa los valores.
# El archivo ".env" esta en .gitignore: no se sube al repositorio.

# ---------------------------------------------------------------
# Django
# ---------------------------------------------------------------
DJANGO_DEBUG=True
# Obligatoria cuando DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo se usan si DJANGO_DEBUG=False (produccion con MySQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=

# ---------------------------------------------------------------
# Asistente IA (Groq remoto, compatible con OpenAI)
# ---------------------------------------------------------------
# Clave gratuita de https://console.groq.com  (NO la subas al repositorio)
# Sin clave, el asistente muestra un mensaje amable y nunca lanza errores.
IA_API_KEY=

# Compatible con OpenAI: sirve para Groq, OpenRouter u OpenAI
IA_BASE_URL=https://api.groq.com/openai/v1
IA_MODEL=openai/gpt-oss-20b
IA_TIMEOUT=15
IA_MAX_TOKENS=400
